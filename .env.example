# Copy this file to `.env` (which is git-ignored) and edit if needed.
# This project needs NO API keys. Every variable below is optional.

# Where Hugging Face caches downloaded models/datasets.
# Leave unset to use the default (~/.cache/huggingface).
# HF_HOME=./.hf_cache

# Only needed if you later swap in a gated model (e.g. some Llama checkpoints).
# The default model (SmolLM2-135M, Apache-2.0) is NOT gated.
# Create a READ-scoped token at https://huggingface.co/settings/tokens
# HF_TOKEN=

# Set to 1 to forbid network access once the model is cached.
# HF_HUB_OFFLINE=0

# Silence tokenizer fork warnings.
TOKENIZERS_PARALLELISM=false